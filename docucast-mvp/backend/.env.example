# Copy this file to .env and fill in your Google Gemini API key.
# Get a key from https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# The deployed Vercel frontend origin (no trailing slash).
# Example: https://docucast-mvp.vercel.app
# Leave empty during local development; localhost origins are always allowed.
VERCEL_ORIGIN=
