# === LLM Provider (which AI engine generates the podcast script) ===
# Options: auto | gemini | groq | openrouter | cerebras | huggingface | ollama | local
# "auto" tries providers in order: Gemini -> Groq -> OpenRouter -> Cerebras -> HF -> Ollama -> Local
# "local" uses the built-in offline summarizer (unlimited, no API key needed)
LLM_PROVIDER=auto

# === API Keys (all optional — local fallback always works) ===

# Gemini (free tier: 60 req/min, 1500/day)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash  # optional override

# Groq (FREE, 14k req/day — recommended alternative)
# Get key at https://console.groq.com/keys (no credit card)
# GROQ_API_KEY=gsk_...

# OpenRouter (FREE :free models, no credit card)
# Get key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1_...

# Cerebras (free tier, ultra fast)
# CEREBRAS_API_KEY=...

# Hugging Face Inference (free)
# HF_TOKEN=hf_...

# Ollama (100% free, unlimited, offline — install from https://ollama.com)
# OLLAMA_HOST=http://localhost:11434

# === Auth (login gate for the frontend) ===
# DOCUCAST_USERNAME=admin
# DOCUCAST_PASSWORD=docucast
# DOCUCAST_AUTH_SECRET=change-me-for-deployment
# DOCUCAST_TOKEN_TTL_SECONDS=43200
# Set to false on public deployments to close open registration (the backend
# proxies your LLM API keys, so anyone registered can consume your quota)
# ALLOW_REGISTRATION=true

# === Deployment ===
# VERCEL_ORIGIN=https://your-frontend.vercel.app
