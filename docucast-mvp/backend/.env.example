# DocuCast - AI Provider Configuration
# Pick ANY ONE free alternative when Gemini limits are finished.
# If you set nothing, the app uses LOCAL fallback (unlimited, offline, no key needed).

# --- Option 1: Gemini (original) - free tier but quota-limited ---
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash  # optional, defaults to gemini-3.6-flash then fallback to 2.0/1.5

# --- Option 2: Groq ⭐ RECOMMENDED FREE ALTERNATIVE ---
# Free 14,400 requests/day, super fast, no credit card
# Get key: https://console.groq.com/keys (30 sec signup)
# GROQ_API_KEY=gsk_...

# --- Option 3: OpenRouter (many free models) ---
# Get key: https://openrouter.ai/keys
# Models like qwen/qwen-2.5-7b-instruct:free, meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_API_KEY=sk-or-v1-...

# --- Option 4: Cerebras (free tier, ultra fast) ---
# Get key: https://cloud.cerebras.ai/
# CEREBRAS_API_KEY=csk-...

# --- Option 5: Hugging Face (free inference) ---
# Get token: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# --- Option 6: Ollama (100% FREE, UNLIMITED, OFFLINE, NO API KEY) ---
# Install: https://ollama.com  then run:
#   ollama pull llama3.2
#   ollama serve
# OLLAMA_HOST=http://localhost:11434

# --- Choice of provider ---
# auto = try Gemini -> Groq -> OpenRouter -> Cerebras -> HF -> Ollama -> local (recommended)
# Set to force one: gemini, groq, openrouter, cerebras, huggingface, ollama, local
# For unlimited offline with no keys, use: local
LLM_PROVIDER=auto

# --- Deployment ---
# The deployed Vercel frontend origin (no trailing slash).
# Example: https://docucast-mvp.vercel.app
# Leave empty during local dev; localhost is always allowed.
VERCEL_ORIGIN=
